from typing import Any
from ..common import BlockingLoad, PollBlockingLoad


class CudaEventSyncer(BlockingLoad, PollBlockingLoad):
    def __init__(self, cuda_stream_i: int) -> None: ...
    def get_blocking_delegate(self) -> Any: ...
    def run_blocking_delegate(self) -> None: ...
    def retrieve_result(self) -> None: ...
    def get_poll_delegate(self) -> Any: ...
    def query_finished(self) -> bool: ...


class CudaMemoryCopier(BlockingLoad):
    def __init__(self,
                 size: int,
                 dst_ptr: int, dst_is_device: bool,
                 src_ptr: int, src_is_device: bool,
                 cuda_stream_i: int
                 ) -> None: ...

    def get_blocking_delegate(self) -> Any: ...
    def run_blocking_delegate(self) -> None: ...
    def retrieve_result(self) -> None: ...
