class QunatLinearHolderV2(object):
    def __init__(self, quantization_group_size: int, use_act_order: bool) -> None:
        self.quantization_group_size = quantization_group_size
        self.use_act_order = use_act_order
        self.quant_linears: list[QuantLinearV2] = []

    def apply(self, func: Callable[[QuantLinearV2], None]):
        [func(l) for l in self.quant_linears]
        return self

    # def set_forward_method(self, method: QUANT_FORWARD_METHOD):
    #     self.apply(lambda quant_linear: quant_linear.set_forward_method(method))
    #     return self

    def post_init(self, tunning_params: TuningParams, shared_cache: CacheV2):
        self.apply(lambda quant_linear: quant_linear.post_init(tunning_params, shared_cache))
        return self

    def set_tuning_param(self, tuning_param: TuningParams):
        self.apply(lambda quant_linear: quant_linear.q4_matrix.set_tuning_params(tuning_param))
        return self

    def make_linear(self, in_features: int, out_features: int, bias: bool = False) -> QuantLinearV2:
        linear = QuantLinearV2(group_size=self.quantization_group_size,
                               in_features=in_features, out_features=out_features,
                               bias=bias,
                               use_act_order=self.use_act_order)
        self.quant_linears.append(linear)
        return linear

        # self.max_weight_elements = 0
        # self.max_x_featrues = 0

